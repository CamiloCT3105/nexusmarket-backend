// Esquema relacional de NexusMarket (PostgreSQL).
//
// Aquí vive lo transaccional: usuarios, bodegas, existencias, pedidos, facturas,
// envíos, devoluciones y reembolsos. El catálogo de productos, los carritos y la
// bitácora de movimientos de inventario van en MongoDB; por eso las columnas
// `product_id` son texto sin llave foránea.
//
// Convenciones: modelos en PascalCase y campos en camelCase (como en TypeScript),
// tablas y columnas en snake_case (como en SQL) mediante @@map / @map.
// El dinero se guarda como DECIMAL(12,2), nunca como punto flotante.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums (mismos valores que src/models) ─────────────────────────────────────

enum UserRole {
  BUYER
  SELLER
  LOGISTICS_OPERATOR
  ADMIN
  SUPERVISOR
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum CommercialStatus {
  ACTIVE
  RESTRICTED
}

enum WarehouseType {
  MARKETPLACE
  SELLER
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  SHIPPED
  DELIVERED
}

enum ShipmentStatus {
  PREPARING
  IN_TRANSIT
  DELIVERED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
}

enum RefundStatus {
  PENDING
  COMPLETED
}

// ─── Usuarios y perfiles ───────────────────────────────────────────────────────

model User {
  id        String     @id @db.Uuid
  fullName  String     @map("full_name")
  email     String     @unique
  role      UserRole
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  credential Credential?
  buyer      Buyer?
  seller     Seller?

  @@map("users")
}

// Separada de users a propósito (D-12): el hash nunca viaja con el usuario
model Credential {
  userId       String @id @map("user_id") @db.Uuid
  passwordHash String @map("password_hash")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credentials")
}

model Buyer {
  userId           String           @id @map("user_id") @db.Uuid
  commercialStatus CommercialStatus @default(ACTIVE) @map("commercial_status")

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  addresses BuyerAddress[]
  orders    Order[]

  @@map("buyers")
}

// Dirección principal (isPrimary = true) y adicionales del comprador
model BuyerAddress {
  id         String  @id @default(uuid()) @db.Uuid
  buyerId    String  @map("buyer_id") @db.Uuid
  street     String
  city       String
  country    String
  postalCode String  @map("postal_code")
  isPrimary  Boolean @default(false) @map("is_primary")

  buyer Buyer @relation(fields: [buyerId], references: [userId], onDelete: Cascade)

  @@index([buyerId])
  @@map("buyer_addresses")
}

model Seller {
  userId String @id @map("user_id") @db.Uuid

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouses Warehouse[]

  @@map("sellers")
}

// ─── Bodegas e inventario ──────────────────────────────────────────────────────

model Warehouse {
  id       String        @id @db.Uuid
  type     WarehouseType
  location String
  sellerId String?       @map("seller_id") @db.Uuid // solo para type = SELLER

  seller    Seller?         @relation(fields: [sellerId], references: [userId])
  inventory InventoryItem[]

  @@index([sellerId])
  @@map("warehouses")
}

// Existencias actuales de un producto en una bodega. El checkout bloquea estas filas
// dentro de una transacción para no vender stock que no existe.
model InventoryItem {
  productId        String @map("product_id") // producto en MongoDB
  warehouseId      String @map("warehouse_id") @db.Uuid
  quantity         Int    @default(0)
  reservedQuantity Int    @default(0) @map("reserved_quantity")
  damagedQuantity  Int    @default(0) @map("damaged_quantity")

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@id([productId, warehouseId])
  @@map("inventory_items")
}

// ─── Pedidos y posventa ────────────────────────────────────────────────────────

model Order {
  id        String      @id @db.Uuid
  buyerId   String      @map("buyer_id") @db.Uuid
  total     Decimal     @db.Decimal(12, 2)
  status    OrderStatus @default(PENDING_PAYMENT)
  createdAt DateTime    @default(now()) @map("created_at")

  buyer    Buyer           @relation(fields: [buyerId], references: [userId])
  items    OrderItem[]
  invoice  Invoice?
  shipment Shipment?
  returns  ReturnRequest[]

  @@index([buyerId])
  @@index([status, createdAt])
  @@map("orders")
}

// unitPrice es una instantánea del precio al momento de la compra (D-10)
model OrderItem {
  orderId     String  @map("order_id") @db.Uuid
  productId   String  @map("product_id") // producto en MongoDB
  warehouseId String  @map("warehouse_id") @db.Uuid
  quantity    Int
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@id([orderId, productId])
  @@map("order_items")
}

model Invoice {
  id       String   @id @db.Uuid
  orderId  String   @unique @map("order_id") @db.Uuid // una factura por pedido
  buyerId  String   @map("buyer_id") @db.Uuid
  amount   Decimal  @db.Decimal(12, 2)
  issuedAt DateTime @default(now()) @map("issued_at")

  order Order @relation(fields: [orderId], references: [id])

  @@index([buyerId])
  @@map("invoices")
}

model Shipment {
  id           String         @id @db.Uuid
  orderId      String         @unique @map("order_id") @db.Uuid // un envío por pedido
  trackingCode String         @unique @map("tracking_code")
  status       ShipmentStatus @default(PREPARING)

  order  Order           @relation(fields: [orderId], references: [id])
  events ShipmentEvent[]

  @@map("shipments")
}

model ShipmentEvent {
  id         String         @id @default(uuid()) @db.Uuid
  shipmentId String         @map("shipment_id") @db.Uuid
  status     ShipmentStatus
  note       String         @default("")
  createdAt  DateTime       @default(now()) @map("created_at")

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, createdAt])
  @@map("shipment_events")
}

model ReturnRequest {
  id        String       @id @db.Uuid
  orderId   String       @map("order_id") @db.Uuid
  productId String       @map("product_id") // producto en MongoDB
  quantity  Int
  reason    String
  status    ReturnStatus @default(REQUESTED)
  createdAt DateTime     @default(now()) @map("created_at")

  order  Order   @relation(fields: [orderId], references: [id])
  refund Refund?

  @@index([orderId, productId])
  @@map("return_requests")
}

model Refund {
  id        String       @id @db.Uuid
  returnId  String       @unique @map("return_id") @db.Uuid // un reembolso por devolución
  amount    Decimal      @db.Decimal(12, 2)
  status    RefundStatus @default(PENDING)
  createdAt DateTime     @default(now()) @map("created_at")

  returnRequest ReturnRequest @relation(fields: [returnId], references: [id])

  @@map("refunds")
}

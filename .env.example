# Copia este archivo como .env y ajusta los valores.

# Servidor
PORT=3000
NODE_ENV=development

# Frontends que pueden llamar a la API desde el navegador (separados por coma)
CORS_ORIGIN=http://localhost:5173

# Proxies de confianza delante de la API (para conocer la IP real del cliente). Vacío en local;
# en Render va 3 (Cloudflare, balanceador y servicio). No lo actives sin proxy: cualquiera podría
# falsear su IP con X-Forwarded-For.
TRUST_PROXY=

# Límites de peticiones en las rutas públicas (opcionales; estos son los valores por defecto)
RATE_LIMIT_LOGIN_PER_ACCOUNT=10
RATE_LIMIT_LOGIN_PER_IP=100
RATE_LIMIT_REGISTER_PER_IP=30

# Autenticación (JWT_SECRET es obligatorio: usa una cadena larga y aleatoria)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN_SECONDS=28800

# Primer administrador (se crea al arrancar si no existe)
ADMIN_EMAIL=admin@nexusmarket.local
ADMIN_PASSWORD=cambia-esta-clave
# Documento de identidad del administrador (único en la plataforma)
ADMIN_DOCUMENT_NUMBER=1000000000

# Bases de datos: levántalas con `docker compose up -d`.
# Estos valores coinciden con los predeterminados de docker-compose.yml.
DATABASE_URL=postgresql://nexus:nexus_dev_password@localhost:5432/nexusmarket?schema=public
MONGO_URL=mongodb://nexus:nexus_dev_password@localhost:27018/nexusmarket?authSource=admin
